# Registers the scaffold's architecture rules with PHPStan.
#
# The values the rules work with live in phpstan.neon.dist, under
# parameters.architecture, so that a plugin generated from the scaffold only
# edits them in one place. This file declares their shape and wires the rules.
# docs/architecture-rules.md describes every rule.

parametersSchema:
    architecture: structure([
        namespace: string()
        excludedNamespaces: listOf(string())
        finalByDefault: structure([
            baseClasses: listOf(string())
        ])
        noStaticState: structure([
            allowed: listOf(string())
        ])
        exceptions: structure([
            namespace: string()
            marker: string()
            notExceptions: listOf(string())
        ])
        noWordPressErrorMechanisms: structure([
            boundaryAdapters: listOf(string())
        ])
    ])

services:
    architecturePluginNamespace:
        class: MWPD\BasicScaffold\Tests\PHPStan\Rule\PluginNamespace
        arguments:
            root: %architecture.namespace%
            excluded: %architecture.excludedNamespaces%
        autowired: false

    -
        class: MWPD\BasicScaffold\Tests\PHPStan\Rule\FinalByDefaultRule
        arguments:
            plugin_namespace: @architecturePluginNamespace
            base_classes: %architecture.finalByDefault.baseClasses%
        tags:
            - phpstan.rules.rule

    -
        class: MWPD\BasicScaffold\Tests\PHPStan\Rule\NoStaticStateRule
        arguments:
            plugin_namespace: @architecturePluginNamespace
            allowed: %architecture.noStaticState.allowed%
        tags:
            - phpstan.rules.rule

    -
        class: MWPD\BasicScaffold\Tests\PHPStan\Rule\NoErrorReportingFunctionsRule
        arguments:
            plugin_namespace: @architecturePluginNamespace
            reflection: @PHPStan\Reflection\ReflectionProvider
        tags:
            - phpstan.rules.rule

    architectureWordPressErrorTransport:
        class: MWPD\BasicScaffold\Tests\PHPStan\Rule\WordPressErrorTransport
        arguments:
            plugin_namespace: @architecturePluginNamespace
            boundary_adapters: %architecture.noWordPressErrorMechanisms.boundaryAdapters%
            reflection: @PHPStan\Reflection\ReflectionProvider
        autowired: false

    -
        class: MWPD\BasicScaffold\Tests\PHPStan\Rule\NoWordPressErrorCreationRule
        arguments:
            transport: @architectureWordPressErrorTransport
        tags:
            - phpstan.rules.rule

    -
        class: MWPD\BasicScaffold\Tests\PHPStan\Rule\NoWordPressErrorInMethodsRule
        arguments:
            transport: @architectureWordPressErrorTransport
        tags:
            - phpstan.rules.rule

    -
        class: MWPD\BasicScaffold\Tests\PHPStan\Rule\NoWordPressErrorInFunctionsRule
        arguments:
            transport: @architectureWordPressErrorTransport
        tags:
            - phpstan.rules.rule

    -
        class: MWPD\BasicScaffold\Tests\PHPStan\Rule\NoWordPressErrorInPropertiesRule
        arguments:
            transport: @architectureWordPressErrorTransport
        tags:
            - phpstan.rules.rule

    -
        class: MWPD\BasicScaffold\Tests\PHPStan\Rule\NoWordPressErrorInClosuresRule
        arguments:
            transport: @architectureWordPressErrorTransport
        tags:
            - phpstan.rules.rule

    -
        class: MWPD\BasicScaffold\Tests\PHPStan\Rule\NoWordPressErrorInArrowFunctionsRule
        arguments:
            transport: @architectureWordPressErrorTransport
        tags:
            - phpstan.rules.rule

    -
        class: MWPD\BasicScaffold\Tests\PHPStan\Rule\ThrowOnlyPluginExceptionsRule
        arguments:
            plugin_namespace: @architecturePluginNamespace
            marker: %architecture.exceptions.marker%
            exception_namespace: %architecture.exceptions.namespace%
        tags:
            - phpstan.rules.rule

    -
        class: MWPD\BasicScaffold\Tests\PHPStan\Rule\CreateOnlyPluginExceptionsRule
        arguments:
            plugin_namespace: @architecturePluginNamespace
            marker: %architecture.exceptions.marker%
            exception_namespace: %architecture.exceptions.namespace%
        tags:
            - phpstan.rules.rule

    -
        class: MWPD\BasicScaffold\Tests\PHPStan\Rule\ExceptionShapeRule
        arguments:
            plugin_namespace: @architecturePluginNamespace
            marker: %architecture.exceptions.marker%
            exception_namespace: %architecture.exceptions.namespace%
            exempt: %architecture.exceptions.notExceptions%
        tags:
            - phpstan.rules.rule

    -
        class: MWPD\BasicScaffold\Tests\PHPStan\Rule\ExceptionsThroughNamedConstructorsRule
        arguments:
            plugin_namespace: @architecturePluginNamespace
            marker: %architecture.exceptions.marker%
        tags:
            - phpstan.rules.rule
