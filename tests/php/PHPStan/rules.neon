# Registers the scaffold's architecture rules with PHPStan.
#
# The values the rules work with live in phpstan.neon.dist, under
# parameters.architecture, so that a plugin generated from the scaffold only
# edits them in one place. This file declares their shape and wires the rules.
# docs/architecture-rules.md describes every rule.

parametersSchema:
    architecture: structure([
        namespace: string()
        excludedNamespaces: listOf(string())
        finalByDefault: structure([
            baseClasses: listOf(string())
        ])
        noStaticState: structure([
            allowed: listOf(string())
        ])
    ])

services:
    architecturePluginNamespace:
        class: MWPD\BasicScaffold\Tests\PHPStan\Rule\PluginNamespace
        arguments:
            root: %architecture.namespace%
            excluded: %architecture.excludedNamespaces%
        autowired: false

    -
        class: MWPD\BasicScaffold\Tests\PHPStan\Rule\FinalByDefaultRule
        arguments:
            plugin_namespace: @architecturePluginNamespace
            base_classes: %architecture.finalByDefault.baseClasses%
        tags:
            - phpstan.rules.rule

    -
        class: MWPD\BasicScaffold\Tests\PHPStan\Rule\NoStaticStateRule
        arguments:
            plugin_namespace: @architecturePluginNamespace
            allowed: %architecture.noStaticState.allowed%
        tags:
            - phpstan.rules.rule
