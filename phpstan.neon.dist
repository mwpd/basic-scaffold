includes:
    - vendor/szepeviktor/phpstan-wordpress/extension.neon
    - tests/php/PHPStan/rules.neon

parameters:
    level: max
    treatPhpDocTypesAsCertain: false
    paths:
        - src
        - tests
        - views
    bootstrapFiles:
        - vendor/php-stubs/wordpress-stubs/wordpress-stubs.php 
    excludePaths:
        - tests/php/Fixture/views/broken-view.php
        # Fixtures for the architecture rules break those rules on purpose.
        - tests/php/PHPStan/Fixture
    ignoreErrors:
        # Ignore errors related to ReflectionClass subtype, see https://github.com/phpstan/phpstan/issues/4078
        - '#SimpleInjector::get_dependencies_for\(\) has parameter \$reflection with generic class ReflectionClass but does not specify its types#'
        - '#SimpleInjector::ensure_is_instantiable\(\) has parameter \$reflection with generic class ReflectionClass but does not specify its types#'
        - '#SimpleInjector::get_class_reflection\(\) return type with generic class ReflectionClass does not specify its types#'
        # Ignore errors related to echo and type casting in views.
        - '#Parameter \#1 \(mixed\) of echo cannot be converted to string.#'

    # Settings for the architecture rules (tests/php/PHPStan/rules.neon), see
    # docs/architecture-rules.md. Rename the namespaces together with the
    # plugin's namespace.
    architecture:
        # Code the rules apply to.
        namespace: MWPD\BasicScaffold
        # Parts of that namespace that are not plugin code.
        excludedNamespaces:
            - MWPD\BasicScaffold\Tests
        finalByDefault:
            # Classes designed to be extended (design principle 6).
            baseClasses:
                - MWPD\BasicScaffold\Infrastructure\View\SimpleView
        noStaticState:
            # Methods allowed to keep static state (design principle 5).
            allowed:
                - MWPD\BasicScaffold\BasicScaffoldPluginFactory::create
        exceptions:
            # Where the plugin's exceptions live, and the interface they all
            # implement (design principle 10).
            namespace: MWPD\BasicScaffold\Exception
            marker: MWPD\BasicScaffold\Exception\BasicScaffoldException
            # Code in that namespace that is not an exception.
            notExceptions:
                - MWPD\BasicScaffold\Exception\Stringify
        noWordPressErrorMechanisms:
            # Classes that hand a WP_Error to WordPress where it expects one.
            boundaryAdapters: []
        dependencyDirection:
            # The layer generated plugins build on (design principle 4).
            infrastructure: MWPD\BasicScaffold\Infrastructure
            # The only classes that know the concrete classes and wire the
            # plugin together (design principle 5).
            compositionRoot:
                - MWPD\BasicScaffold\BasicScaffoldPlugin
                - MWPD\BasicScaffold\BasicScaffoldPluginFactory
